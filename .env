# Rename this file to .env and fill values before running

# Discord bot token (required)
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Admin role ID (optional) - numeric role id from your guild
ADMIN_ROLE_ID=0

# Comma separated admin user IDs (optional)
ADMIN_USER_IDS=123456789012345678,987654321098765432

# SQLite DB path (relative)
DB_PATH=vps_manager.db

# Directory for data (make sure this path exists or change it)
DATA_DIR=./data

# Default CPU shares and memory for new containers
DEFAULT_CPU_SHARES=1024
DEFAULT_MEMORY=512m

# Whether to auto pull base images on startup
AUTO_PULL_IMAGES=true

# Log level (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# (Optional) If you want the bot container to connect to remote docker daemon, set DOCKER_HOST
# DOCKER_HOST=tcp://1.2.3.4:2376
